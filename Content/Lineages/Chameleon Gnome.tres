[resource]
script = ExtResource("1_k1elx")
l_name = "Chameleon Gnome"
description = "Your hair and skin color are mutable, possibly due to latent magic from First Worldinfluences. You can slowly change the vibrancy and exact color of your skin and hair,creating patterns or designs. This process takes one action for minor shifts and up toan hour for dramatic changes. When in an area where your coloration is similar to theenvironment, you gain a +2 circumstance bonus to Stealth checks."
