[sub_resource type="Resource" id="Resource_8uaco"]
script = ExtResource("2_brt6x")
t_name = "Agile"
description = "The multiple attack penalty you take with this weapon on the second attack on your turn is –4 instead of –5, and –8 instead of –10 on the third and subsequent attacks in the turn."
category = ["Weapon Traits"]
parameters = {}

[sub_resource type="Resource" id="Resource_mwcji"]
script = ExtResource("2_brt6x")
t_name = "Finesse"
description = "With this melee weapon, you may substitute your Agility modifier for your Might modifier on attack rolls, though damage remains determined by Might."
category = ["Weapon Traits"]
parameters = {}

[sub_resource type="Resource" id="Resource_hxhye"]
script = ExtResource("2_brt6x")
t_name = "Nonlethal"
description = "Attacks with this weapon are nonlethal, designed to render creatures unconscious rather than kill them. You can choose to make a lethal attack with a nonlethal weapon, but it incurs a –2 circumstance penalty."
category = ["Weapon Traits"]
parameters = {}

[sub_resource type="Resource" id="Resource_4bejq"]
script = ExtResource("2_brt6x")
t_name = "Unarmed"
description = "An unarmed attack relies on your body instead of a crafted weapon, lacking the status of a weapon but belonging to a weapon group and possibly bearing weapon traits. It cannot be Disarmed and doesn’t occupy a hand, though a fist or similar gripping limb typically functions akin to a free-hand weapon."
category = ["Weapon Traits"]
parameters = {}

