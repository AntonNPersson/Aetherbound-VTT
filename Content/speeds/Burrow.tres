[resource]
script = ExtResource("1_sx6qs")
s_name = "Burrow"
description = "Grants the ability to tunnel through earth, sand, snow, or similar loose materials using the Burrow action, creating a tunnel behind you unless specified otherwise. This speed usually doesn't work through solid stone. You typically cannot breathe while burrowing unless you have a specific ability allowing it."
metadata/_custom_type_script = "uid://1g3sfuiuv4a7"
