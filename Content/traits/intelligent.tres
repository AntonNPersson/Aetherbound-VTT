script = ExtResource("1_sou7j")
t_name = "Intelligent"
description = "An item bearing this trait possesses intelligence, complete with its own will, personality, and unique statistics uncommon among typical items. Intelligent items cannot be created through standard crafting methods and are invariably rare or one-of-a-kind."
category = ["Equipment"]
