script = ExtResource("1_snyu6")
t_name = "Shade"
description = "Shades are the souls of mortals that, after judgment, have been converted into beings indigenous to different planes. These petitioners are capable of enduring the fundamental environmental conditions of their native plane."
category = ["Creature Type"]
