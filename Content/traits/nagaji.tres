script = ExtResource("1_6sanb")
t_name = "Nagaji"
description = "Nagaji are muscular humanoids characterized by their reptilian features, including scaly skin and snake-like heads. Many of them either work for or hold deep reverence towards nagas."
category = ["Monster"]
