script = ExtResource("1_c7jbn")
t_name = "Asura"
description = "These orderly fiends embody the unintended consequences of divine mishaps. Asuras generally possess darkvision, resistance to curses, and a vulnerability to good-aligned forces."
category = ["Monster"]
