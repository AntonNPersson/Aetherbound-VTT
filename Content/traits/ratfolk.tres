[resource]
script = ExtResource("1_mh0qy")
t_name = "Ratfolk"
description = "A creature possessing this trait belongs to the ratfolk ancestry, which consists of humanoids bearing a striking resemblance to rats. An ability that carries this trait can only be utilized or chosen by members of the ratfolk species."
category = ["Monster"]
