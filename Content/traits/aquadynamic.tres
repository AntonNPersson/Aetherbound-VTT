script = ExtResource("1_4k7im")
t_name = "Aquadynamic"
description = "This armor is tailored for aquatic environments, featuring a streamlined shape and buoyant materials strategically placed. It negates the armor's check penalty when making Acrobatics or Athletics checks in water or similar fluids."
