[resource]
script = ExtResource("1_flxd0")
t_name = "Parry"
description = "This weapon is adept at fending off attacks when used defensively. If you’re a novice or higher in proficiency with it, you can take a single action to hold it in a protective stance while wielding it, earning a +1 circumstance bonus to AC until your next turn begins."
category = ["Weapon Traits"]
