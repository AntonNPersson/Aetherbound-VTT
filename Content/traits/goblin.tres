[resource]
script = ExtResource("1_o5x3n")
t_name = "Goblin"
description = "A creature with this trait is a small, excitable goblinoid. Goblins typically possess darkvision. An ability marked by this trait is exclusive to goblins for use or selection. A weapon bearing this trait is forged and employed by goblins."
category = ["Species", "Weapon"]
