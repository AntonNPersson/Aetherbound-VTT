[resource]
script = ExtResource("1_uvpu5")
t_name = "Bulwark"
description = "This armor offers such comprehensive coverage that it provides advantages against certain damaging effects. When you make an Agility save to dodge a damaging effect like a fireball, you add a +3 modifier rather than your Agility modifier."
category = ["Armor"]
