[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_khwxm"]

[resource]
script = ExtResource("1_khwxm")
t_name = "Stance"
description = "A stance is a broad fighting approach you adopt by performing an action with the stance trait, maintaining it for a duration. It persists until you’re knocked unconscious, its conditions (if any) are broken, the encounter ends, or you activate another stance action—whichever happens first. After using a stance action, you must wait 1 round before using another. Stances are usable only in encounter mode, and you can Dismiss them at will."
category = ["Class-Specific"]
