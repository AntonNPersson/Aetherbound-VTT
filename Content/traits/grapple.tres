[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_4umn3"]

[resource]
script = ExtResource("1_4umn3")
t_name = "Grapple"
description = "This weapon enables you to Grapple using the Athletics skill without needing a free hand, utilizing the weapon’s reach (if it differs from yours) and applying its item bonus to attack rolls as an item bonus to the Athletics check. On a critical failure during a Grapple attempt with this weapon, you can release it to suffer only a failure’s consequences rather than a critical failure’s."
category = ["Weapon Traits"]
