[resource]
script = ExtResource("1_f412y")
t_name = "Primal"
description = "This magic flows from the primal tradition, rooted in the natural realm and raw instinct. Any object or effect bearing this trait is inherently magical. / A creature with this trait is either predominantly formed from primal magic or shares a deep bond with it."
category = ["Monster", "Tradition"]
