[resource]
script = ExtResource("1_h4cd8")
t_name = "Mindless"
description = "A being without consciousness or intelligence possesses either pre-determined responses or basic mental capabilities. The majority, if not all, of their mental attribute modifiers are -5. They are impervious to any form of mental manipulation."
category = ["Monster"]
