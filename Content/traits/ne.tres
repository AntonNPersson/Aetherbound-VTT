script = ExtResource("1_kbfl7")
t_name = "NE"
description = "Stands for Neutral Evil. Creatures with this alignment are primarily concerned with their own gain and power, harming others whenever it is advantageous. They are pragmatic in their evil, unbound by codes or the need for chaos."
category = ["Alignment"]
