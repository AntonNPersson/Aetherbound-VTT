[resource]
script = ExtResource("1_i4k52")
t_name = "N"
description = "Stands for Neutral (often called True Neutral). Creatures with this alignment avoid extremes of law vs. chaos and good vs. evil. They might seek balance, act pragmatically based on the situation, or lack strong convictions either way."
category = ["Alignment"]
