script = ExtResource("1_tv7x2")
t_name = "Large"
description = "Creatures of this size are larger than Medium creatures, typically occupying a 10-foot by 10-foot square space (4 squares). They often have a longer reach. Examples include ogres, horses, and trolls."
category = ["Size"]
