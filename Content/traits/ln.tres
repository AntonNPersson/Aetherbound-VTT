script = ExtResource("1_r1v8d")
t_name = "LN"
description = "Stands for Lawful Neutral. Creatures with this alignment uphold laws, traditions, or personal codes above all else. They believe in order and organization, acting reliably but without a strong inclination towards good or evil."
category = ["Alignment"]
