script = ExtResource("1_cuii0")
t_name = "Laminar"
description = "Constructed from multiple layers, this armor mitigates the impact of damage. If broken, it reduces the penalty to Armor Class (AC): -1 for medium armor, -2 for heavy armor, and there's no penalty for light armor."
category = ["Armor"]
