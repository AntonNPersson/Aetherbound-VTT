[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_fbfx0"]

[resource]
script = ExtResource("1_fbfx0")
t_name = "Contingency"
description = "Spells bearing this trait provide you with an action—usually a reaction tied to a unique trigger—during their duration. These spells often last a significant time, such as 24 hours. You can only maintain one spell with the contingency trait, or one contingency spell, at a time. Casting a new spell with the contingency trait or contingency overrides any previous one."
category = ["Mechanics"]
