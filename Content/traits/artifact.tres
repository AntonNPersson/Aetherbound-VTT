[resource]
script = ExtResource("1_oct7m")
t_name = "Artifact"
description = "Items bearing this trait are classified as artifacts. These magical objects cannot be forged through conventional methods nor harmed by ordinary means. Artifacts are invariably rare or one-of-a-kind."
category = ["Equipment"]
