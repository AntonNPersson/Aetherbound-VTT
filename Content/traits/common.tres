[resource]
script = ExtResource("1_h6xdo")
t_name = "Common"
description = "Anything not marked with another rarity (uncommon, rare, or unique) is considered common. This denotes widespread availability to qualifying players. Common creatures are well-known and can be summoned via spells."
category = ["Rarity"]
