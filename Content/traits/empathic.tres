[resource]
script = ExtResource("1_sjv8b")
t_name = "Empathic"
description = "This magic stems from the empathic tradition, rooted in passion and emotion. Any entity or effect bearing this trait is inherently magical. / A creature with this trait is either predominantly composed of empathic magic or possesses a significant tie to it."
category = ["Monster", "Tradition"]
