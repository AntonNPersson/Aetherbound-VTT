[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_ufv2c"]

[resource]
script = ExtResource("1_ufv2c")
t_name = "Razing"
description = "Razing weapons excel at wrecking objects, structures, and vehicles. When you strike an object (such as shields or animated items), structure, or vehicle with a razing weapon, it suffers extra damage equal to twice the number of the weapon’s damage dice."
category = ["Weapon Traits"]
