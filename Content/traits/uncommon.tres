[resource]
script = ExtResource("1_2lfgt")
t_name = "Uncommon"
description = "Uncommon items or abilities require specific training or regional access. Some characters may have access, at the GM's discretion. Uncommon creatures are less known than common ones; they can't be summoned and Recall Knowledge checks about them have a +2 DC."
category = ["Rarity"]
