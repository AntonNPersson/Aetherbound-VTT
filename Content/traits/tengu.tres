script = ExtResource("1_guj0g")
t_name = "Tengu"
description = "A creature bearing this trait belongs to the tengu lineage, a humanoid group with crow-like features. An ability with this trait is exclusive to tengu for use or selection. An item marked with this trait is crafted and employed by tengu."
category = ["Monster"]
