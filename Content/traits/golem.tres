[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_3fybl"]

[resource]
script = ExtResource("1_3fybl")
t_name = "Golem"
description = "This type of construct, known as golems, is characterized by its extraordinary resilience to magical forces, being largely impervious to most forms of magic. However, many golems possess a specific vulnerability to certain spells or incantations that can be leveraged against them."
category = ["Monster"]
