[resource]
script = ExtResource("1_aklgh")
t_name = "Nephilim"
description = "A creature possessing this trait carries the nephilim versatile heritage. Nephilim are planar descendants of undying entities from distant planes. Only nephilim can utilize or choose an ability bearing this trait."
category = ["Lineage", "Monster"]
