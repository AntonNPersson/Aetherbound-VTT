[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_d0nuj"]

[resource]
script = ExtResource("1_d0nuj")
t_name = "Light"
description = "Light effects dispel non-magical darkness in the area and can counteract magical darkness. Typically, you must directly target a darkness effect with light magic to counteract it, though some light spells automatically attempt to do so."
category = ["Mechanics"]
