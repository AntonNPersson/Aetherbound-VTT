[resource]
script = ExtResource("1_p2jjm")
t_name = "Versatile"
description = "A versatile weapon can inflict a damage type other than its standard one, with this trait specifying the alternative type. For example, a piercing weapon marked as versatile S can deal either piercing or slashing damage, and you select the type with each attack."
category = ["Weapon Traits"]
