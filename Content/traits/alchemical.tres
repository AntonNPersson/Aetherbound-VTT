[resource]
script = ExtResource("1_1t7fj")
t_name = "Alchemical"
description = "Alchemical items function through the reactions of alchemical reagents. Unless stated otherwise, they possess no magical nature and produce no magical aura. / Alchemical creatures are sustained in part by alchemical processes."
category = ["Equipment", "Monster", "Weapon"]
