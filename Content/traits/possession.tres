[resource]
script = ExtResource("1_b1w63")
t_name = "Possession"
description = "Possession effects allow a creature to project its mind and spirit into a target. A creature immune to mental effects cannot use possession. While possessing a target, the possessor's true body becomes unconscious and cannot wake normally unless the effect specifically allows the creature to physically enter the target. Whenever the possessed target takes damage, the possessor suffers half that amount as mental damage. / While possessing a target, the possessor loses the benefits of any active spells or abilities affecting its physical body but instead gains the benefits of the target’s active spells and abilities. The possessor can use any of the target’s purely physical abilities but cannot access its own abilities except for spells and purely mental abilities. The GM determines whether an ability is considered physical or mental. When acting through the target, the possessor uses the target’s attack modifier, AC, Endurance and Agility saves, Perception, and physical skills, while retaining its own Wisdom save, mental skills, spell attack modifier, and spell DC. Linked item benefits apply based on whose values are being used—the possessor’s items affect its own stats, while the target’s items apply to its stats. The possessor cannot gain benefits from spells that normally affect only the caster, as it is not in its own body. Additionally, the possessor must use its own actions to control the possessed creature. / If the possessor’s Hit Points reach 0 from a combination of damage to its true body and mental damage from possession, it is knocked out and the possession immediately ends. If the target reaches 0 HP first, the possessor can choose to either fall unconscious with the body and continue the possession or end the effect as a free action and return to its own body. If the target dies, the possession ends immediately, and the possessor is **stunned for 1 minute."
category = ["Mechanics"]
