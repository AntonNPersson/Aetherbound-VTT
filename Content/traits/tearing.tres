script = ExtResource("1_b4nrh")
t_name = "Tearing"
description = "This weapon features curved, serrated teeth along its edge, inflicting lingering cuts. Striking a creature with it adds bleeding 1, which rises to bleeding 2 if the weapon has a greater striking enchantment."
