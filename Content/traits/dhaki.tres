[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_syqc6"]

[resource]
script = ExtResource("1_syqc6")
t_name = "Dhaki"
description = "Creatures with the Dhaki trait are towering, chitinous monstrosities blending insectoid and crystalline features, pulsing with void energy that corrupts their surroundings. Bound by a psychic hivemind led by Sovereigns, they adapt rapidly by assimilating conquered species, wielding crystalline blades, barbed tentacles, and psionic might in their relentless pursuit of evolutionary perfection."
category = ["Creature Type"]
