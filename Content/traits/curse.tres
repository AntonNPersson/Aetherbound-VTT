[resource]
script = ExtResource("1_2kguj")
t_name = "Curse"
description = "A curse is a lingering affliction that burdens a creature over time. Always magical in nature, curses usually stem from spells or traps. Effects bearing this trait can only be lifted by abilities or items explicitly designed to counter curses."
category = "Affliction"
