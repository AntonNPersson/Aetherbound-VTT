script = ExtResource("1_x1yiq")
t_name = "Sweep"
description = "This weapon delivers broad, sweeping strikes. When you use it to attack, you receive a +1 circumstance bonus to your attack roll if you’ve already targeted a different foe with it earlier this turn."
