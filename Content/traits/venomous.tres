script = ExtResource("1_oc7gu")
t_name = "Venomous"
description = "These weapons deliver poison with each strike. Hitting a creature with this weapon inflicts an extra 1 persistent poison damage, which rises to 2 persistent poison damage if the weapon has a greater striking enchantment."
