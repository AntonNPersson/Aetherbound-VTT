[resource]
script = ExtResource("1_c5mj5")
t_name = "Hryngar"
description = "Hryngars, the underground kin of dwarves, boast distinct traits that allow them to flourish in deep realms. They commonly have darkvision, show resilience against poison, and are averse to harsh, brilliant light."
category = ["Monster"]
