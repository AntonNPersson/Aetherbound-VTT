script = ExtResource("1_xeo63")
t_name = "LE"
description = "Stands for Lawful Evil. Creatures with this alignment use order, rules, and hierarchy to achieve selfish or malevolent goals. They exploit systems and dominate others methodically, believing in structure but for nefarious purposes."
category = ["Alignment"]
