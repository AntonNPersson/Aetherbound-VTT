[resource]
script = ExtResource("1_lye2d")
t_name = "Rare"
description = "Rare denotes extreme scarcity in the game world. Rare elements are GM-controlled, typically discovered during play. Rare creatures exist sparingly and cannot be summoned; Recall Knowledge checks about them have a +5 DC."
category = ["Rarity"]
