script = ExtResource("1_m6qrb")
t_name = "Forceful"
description = "This weapon grows deadlier as you gain momentum. If you strike with it multiple times in a turn, the second attack receives a circumstance bonus to damage matching the weapon’s number of damage dice, and each subsequent attack gains a bonus equal to twice that number."
category = ["Weapon Traits"]
