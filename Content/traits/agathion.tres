script = ExtResource("1_vdf62")
t_name = "Agathion"
description = "This family of celestial beings, characterized by animal-like features, originates from the plane of Nirvana. Typically, agathions are neutral good in alignment and possess darkvision capabilities. Additionally, they exhibit a vulnerability to evil-infused damage."
category = ["Monster"]
