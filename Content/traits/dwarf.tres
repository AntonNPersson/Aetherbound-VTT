[resource]
script = ExtResource("1_dsj6a")
t_name = "Dwarf"
description = "A creature possessing this trait belongs to the dwarf lineage. Dwarves are sturdy people, frequently dwelling beneath the surface, and usually equipped with darkvision. Only dwarves can utilize or choose an ability with this trait, and items bearing it are crafted and employed by dwarves."
category = "Species"
