[resource]
script = ExtResource("1_iy6p0")
t_name = "Backswing"
description = "AYou can harness the energy of a missed strike with this weapon to enhance your follow-up attack. If you miss with this weapon during your turn, you receive a +1 circumstance bonus to your next attack with it before your turn ends."
category = ["Weapon Traits"]
