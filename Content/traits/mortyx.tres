script = ExtResource("1_avq5f")
t_name = "Mortyx"
description = "This family of fiends, hailing from the foreboding Shadow Plane, is inextricably linked to the infliction of pain and agony. Each mortyx member possesses a uniquely unsettling theme that can evoke feelings of dread and suffering."
