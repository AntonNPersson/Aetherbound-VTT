script = ExtResource("1_2q6mn")
t_name = "CN"
description = "Stands for Chaotic Neutral. Creatures with this alignment value personal freedom above all else, rejecting authority and constraints. Their actions are often unpredictable, driven by whim or self-interest, without commitment to good or evil."
category = ["Alignment"]
