[resource]
script = ExtResource("1_po2bk")
t_name = "Dero"
description = "This family of humanoids, born from the corrupted essence of once-luminous fey creatures abandoned in the Darklands, have inherited their ancestors' darkness. They possess immunity to confusion and are weakened by exposure to sunlight."
category = ["Monster"]
