[ext_resource type="Script" path="res://Content/Base Resources/TraitRes.gd" id="1_r81cu"]

[resource]
script = ExtResource("1_r81cu")
t_name = "Scatter"
description = "This weapon fires a cluster of pellets in a wide spray. Scatter always has an area listed with it, indicting the radius of the spray. ON a hit, the primary target of attacks with a scatter weapon take the listed damage, and the target and all other creatures within the listed radius around it take 1 point of splash damage per weapon damage die, of the same type as the initial attack. "
category = ["Mechanics"]
