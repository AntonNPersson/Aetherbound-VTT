[resource]
script = ExtResource("1_58fm0")
name = "Heavy Armor"
description = "Proficiency with the most protective types of armor, such as splint mail and full plate. Offers the best base protection but significantly limits Dexterity bonuses to AC and often imposes penalties to speed and certain skills, favoring Strength and resilience over agility."
proficiency_category = 2
proficiency = 0
