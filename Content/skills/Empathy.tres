s_name = "Empathy"
description = "Empathy represents the ability to intuitively perceive, understand, and connect with the emotional states and underlying motivations of others. It covers sensing moods, discerning sincerity or distress, gauging immediate intentions (friendly/hostile), and potentially offering comfort or building rapport based on emotional understanding."
