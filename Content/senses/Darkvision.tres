[resource]
script = ExtResource("1_324sa")
s_name = "Darkvision"
description = "Allows you to see in darkness (even magical darkness unless specified otherwise). Vision in darkness is in black and white only. Darkvision has a limited range (usually specified). This is a Precise sense within its range, allowing you to pinpoint creatures even in darkness."
precision = 0
