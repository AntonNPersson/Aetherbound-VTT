[resource]
script = ExtResource("1_31wkx")
s_name = "Low-light Vision"
description = "Enhances normal vision in conditions of dim light. You can see creatures and objects in dim light as if it were bright light. This does not grant the ability to see in complete darkness. Still a Precise sense where it functions."
precision = 0
