[ext_resource type="Script" uid="uid://cfstqkiy0js58" path="res://Content/Base Resources/SenseRes.gd" id="1_04v8c"]

[resource]
script = ExtResource("1_04v8c")
s_name = "Wavesense"
description = "Detects vibrations in water within a specified range. This is typically a Vague sense. You can sense the presence and direction of creatures or objects in the same body of water as you, but not their exact location (they remain Undetected). Only functions if both you and the target are in the same body of water."
precision = 2
metadata/_custom_type_script = "uid://cfstqkiy0js58"
