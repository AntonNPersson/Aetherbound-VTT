[resource]
script = ExtResource("1_0hp41")
s_name = "Scent"
description = "Detects creatures or objects by smell within a specified range. This is typically an Imprecise sense, functioning similarly to Hearing (reveals location/space, makes Hidden). Strong winds or overwhelming odors can obscure it. It generally doesn't work underwater. Some specific abilities might grant scent as a Vague sense instead."
precision = 1
metadata/_custom_type_script = "uid://cfstqkiy0js58"
