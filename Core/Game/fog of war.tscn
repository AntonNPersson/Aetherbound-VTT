[gd_scene load_steps=2 format=3 uid="uid://cgtplhy3e062e"]

[sub_resource type="GDScript" id="GDScript_5ksqx"]
script/source = "# FogOfWar.gd
extends Node2D

var viewport: Viewport
var fog_sprite: Sprite2D
var visible_polygon: Polygon2D

func _ready():
    # Create a viewport to render the visible area
    viewport = Viewport.new()
    viewport.size = get_viewport_rect().size
    viewport.transparent_bg = true
    viewport.disable_3d = true
    viewport.render_target_update_mode = Viewport.UPDATE_ALWAYS
    add_child(viewport)
    
    # Create a polygon inside the viewport to represent visible area
    visible_polygon = Polygon2D.new()
    visible_polygon.color = Color.WHITE
    viewport.add_child(visible_polygon)
    
    # Create a sprite with a shader to display the fog
    fog_sprite = Sprite2D.new()
    fog_sprite.centered = false
    
    # Setup shader material
    var shader_material = ShaderMaterial.new()
    shader_material.shader = load(\"res://shaders/fog_of_war.gdshader\")
    fog_sprite.material = shader_material
    
    # Set the fog sprite texture to be the viewport texture
    fog_sprite.texture = viewport.get_texture()
    add_child(fog_sprite)

func update_visibility(points: PackedVector2Array, player_pos: Vector2):
    # Update the visible polygon
    visible_polygon.polygon = points
    visible_polygon.global_position = player_pos
    
    # Update shader parameters
    fog_sprite.material.set_shader_parameter(\"player_position\", player_pos)"

[node name="FogOfWar" type="Node2D"]
script = SubResource("GDScript_5ksqx")
